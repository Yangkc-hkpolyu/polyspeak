# Copy to speaking.env. Never put secrets in frontend files.
# The local E: copy already reads DASHSCOPE_API_KEY from backend/.env.
DASHSCOPE_API_KEY=
SPEAKING_MODEL_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
SPEAKING_CHAT_MODEL=qwen-plus-latest
SPEAKING_ASR_MODEL=qwen3-asr-flash
# Active realtime path, matching PolyInterview streamstt and the hosted PCM bridge:
SPEAKING_REALTIME_ASR_MODEL=qwen3-asr-flash-realtime
SPEAKING_REALTIME_TTS_MODEL=qwen3-tts-flash-realtime
# Bunny is a youthful, playful built-in voice. Set Cherry for the previous voice.
SPEAKING_REALTIME_TTS_VOICE=Bunny
# Empty derives the WebSocket host from SPEAKING_MODEL_BASE_URL.
SPEAKING_REALTIME_URL=
SPEAKING_PORT=8008
SPEAKING_AVATAR_DEVICE=auto
# auto selects CUDA, then Apple MPS, then CPU. Optional custom dynamic assets:
# SPEAKING_AVATAR_DIR=/absolute/path/to/avatar-directory
SPEAKING_TTS_PROVIDER=qwen
# Optional real pronunciation assessment. Empty means unavailable, never zero.
AZURE_SPEECH_KEY=
AZURE_REGION=eastus
