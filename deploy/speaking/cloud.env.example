SPEAKING_VOICE_EN=en-US-JennyNeural
SPEAKING_VOICE_ZH=zh-CN-XiaoxiaoNeural
SPEAKING_REALTIME_TTS_VOICE=Cherry
AZURE_SPEECH_KEY=
